# Backend — copiar para backend/.env localmente; nunca commitar o arquivo real
APP_ENV=development
APP_NAME=NEXUS IT ASSET MANAGER
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://nexus:nexus_local_only@localhost:5432/nexus_dev
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# Defina a senha de bootstrap no ambiente ou use comando interativo; não coloque senha real no repositório.
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend — frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api/v1
