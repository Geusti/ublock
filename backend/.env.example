APP_ENV=development
APP_NAME=Ublock IT Asset Manager
API_PREFIX=/api/v1
# In development, you can use SQLite or PostgreSQL:
# PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/ublock
# SQLite (zero dependency): sqlite:///./ublock.db
DATABASE_URL=sqlite:///./ublock.db
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Bootstrap initial Super Admin (can be run via python -m app.scripts.bootstrap_admin)
BOOTSTRAP_ADMIN_EMAIL=admin@ubook.com.br
BOOTSTRAP_ADMIN_PASSWORD=UblockAdmin2026!
BOOTSTRAP_ADMIN_NAME=Administrador Ublock
BOOTSTRAP_ORG_NAME=Ubook Tecnologia
BOOTSTRAP_ORG_SLUG=ubook
